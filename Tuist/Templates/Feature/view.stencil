import ComposableArchitecture
import DesignSystem
import SwiftUI

public struct {{ name }}View: View {
    @Bindable var store: StoreOf<{{ name }}Feature>

    public init(store: StoreOf<{{ name }}Feature>) {
        self.store = store
    }

    public var body: some View {
        VStack {
            Text("{{ name }}")
        }
        .onAppear {
            store.send(.view(.onAppear))
        }
    }
}
